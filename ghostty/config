theme = carbonfox
background-opacity = 0.60
background-blur-radius = 40
# JetBrainsMono Nerd Font, matching hypr-nix -- that host installs
# nerd-fonts.jetbrains-mono as its monospace default.
#
# This line used to say Menlo, which quietly meant two different fonts. NixOS
# has no Menlo, so fontconfig fell through to the Nerd Font and the glyphs
# rendered; macOS does have Menlo, so it won and the prompt lost its icons to
# partial symbol fallback. Naming the font outright makes both hosts agree.
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

adjust-cell-height = 10%
adjust-cursor-thickness = 12
keybind = shift+enter=text:\n
