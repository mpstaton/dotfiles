theme = carbonfox
background-opacity = 0.60
background-blur-radius = 40
# A real Nerd Font rather than Menlo: Menlo carries none of the powerline or
# devicon glyphs the starship prompt and eza's icons use, so every one of them
# was coming from macOS font fallback, which spaces them inconsistently.
font-family = "MesloLGS Nerd Font Mono"
font-size = 14

adjust-cell-height = 10%
adjust-cursor-thickness = 12
keybind = shift+enter=text:\n
